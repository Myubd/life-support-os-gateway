# ============================================================
# life-support-os-gateway .gitignore
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 仮想環境
venv/
.venv/
env/
ENV/

# ---- ローカルDB(SQLite) ----
# core.db等、個人のPCに保存されるユーザーデータは絶対にコミットしない
*.db
*.db-journal
*.sqlite
*.sqlite3

# ---- 環境変数・秘密情報 ----
# GATEWAY_AUTH_TOKEN等が入るファイルは絶対に無視する
.env
.env.*
!.env.example

# ---- OS / エディタ ----
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ---- ログ・一時ファイル ----
*.log
tmp/
temp/

# ---- 相談・共有用に作った圧縮ファイル ----
*.zip
